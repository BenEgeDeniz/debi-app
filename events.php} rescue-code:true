                $orderedList = array_merge(
                    $sections['active'],
                    $sections['attending'],
                    $sections['available'],
                    $sections['past']
                );
                // Tekilleştirme
                $seenIds = [];
                $uniqueEvents = [];
                foreach ($orderedList as $ev) {
                    if (!isset($seenIds[$ev['id']])) {
                        $seenIds[$ev['id']] = true;
                        $uniqueEvents[] = $ev;
                    }
                }

                foreach ($uniqueEvents as $event):
                    // Hangi sekme grubunda yer aldığını belirle
                    $sectionType = 'available';
                    if (in_array($event, $sections['active'], true)) {
                        $sectionType = 'active';
                    } elseif (in_array($event, $sections['attending'], true)) {
                        $sectionType = 'attending';
                    } elseif (in_array($event, $sections['past'], true)) {
                        $sectionType = 'past';
                    }
