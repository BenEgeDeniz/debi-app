                        <?php render_event_card($event, $currentUser, $managedAttendees); ?>
                    </div>
                <?php endforeach; ?>

                <div id="noEventsMatchNotice" class="panel-card empty-state-card" style="display:none;">
                    <h3>Eşleşen etkinlik bulunamadı</h3>
                    <p>Arama veya filtre kriterlerinize uyan bir etkinlik yok. Filtreleri temizleyebilirsiniz.</p>
                </div>
            <?php endif; ?>
        </div>

    </main>
</div>

<script>
(() => {
    const tabs = document.querySelectorAll('[data-tab-filter]');
    const scopeSelect = document.getElementById('eventsScopeSelect');
    const searchInput = document.getElementById('eventsSearchInput');
    const wrappers = document.querySelectorAll('.event-item-wrapper');
    const emptyNotice = document.getElementById('noEventsMatchNotice');

    let currentTab = 'all';
    let currentScope = 'all';
    let searchQuery = '';

    function filterEvents() {
        let visibleCount = 0;

        wrappers.forEach(wrapper => {
            const card = wrapper.querySelector('.event-card-modern');
            if (!card) return;

            const sectionType = wrapper.dataset.sectionType;
            const scope = card.dataset.scope;
            const title = card.dataset.title || '';
            const location = card.dataset.location || '';

            // Sekme Filtresi
            let matchTab = (currentTab === 'all') || (sectionType === currentTab);

            // Kapsam Filtresi
            let matchScope = (currentScope === 'all') || (scope === currentScope);

            // Arama Filtresi
            let matchSearch = true;
            if (searchQuery !== '') {
                matchSearch = title.includes(searchQuery) || location.includes(searchQuery);
            }

            if (matchTab && matchScope && matchSearch) {
                wrapper.style.display = 'block';
                visibleCount++;
            } else {
                wrapper.style.display = 'none';
            }
        });

        if (emptyNotice) {
            emptyNotice.style.display = (visibleCount === 0 && wrappers.length > 0) ? 'block' : 'none';
        }
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            currentTab = tab.dataset.tabFilter;
            filterEvents();
        });
    });

    if (scopeSelect) {
        scopeSelect.addEventListener('change', (e) => {
            currentScope = e.target.value;
            filterEvents();
        });
    }

    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value.trim().toLowerCase();
            filterEvents();
        });
    }
})();
</script>

